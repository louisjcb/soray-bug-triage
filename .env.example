# --- Required ---------------------------------------------------------
# Discord bot token (Developer Portal > your app > Bot > Reset Token)
DISCORD_TOKEN=
# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Comma-separated IDs of the channels the bot watches for bug reports
BUG_CHANNEL_IDS=

# --- Optional: GitHub (without these the bot runs in preview mode) -----
# Fine-grained token with "Issues: read and write" on ONE repository
GITHUB_TOKEN=
# Target repository, as owner/repo
GITHUB_REPO=

# --- Optional: tuning --------------------------------------------------
# Claude model used for triage
ANTHROPIC_MODEL=claude-haiku-5-5
# Ignore reports the model is less sure about (0 to 1)
MIN_CONFIDENCE=0.6
# Ignore very short messages
MIN_MESSAGE_LENGTH=20
# Maximum Claude calls per minute (protects your API budget)
MAX_TRIAGES_PER_MINUTE=10
# Set to true to create issues without moderator approval (not recommended)
AUTO_CREATE=false
